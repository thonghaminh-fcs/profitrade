{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy/home-categories",
	"version": "1.0.0",
	"title": "Shop by Category",
	"category": "sm-sections",
	"icon": "grid-view",
	"description": "Home section: the six shop-by-category tiles (tinted blob + image disc + name) with a “View all products” link to the shop.",
	"keywords": ["categories", "shop", "home", "woocommerce"],
	"textdomain": "ai-zippy-child",
	"supports": {
		"html": false,
		"multiple": false,
		"align": false,
		"spacing": { "margin": false, "padding": false },
		"color": { "text": false, "background": false, "link": false }
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Shop by category"
		},
		"viewAllLabel": {
			"type": "string",
			"default": "View all products →"
		},
		"viewAllUrl": {
			"type": "string",
			"default": "/shop/"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
