{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ai-zippy/contact-location",
	"version": "1.0.0",
	"title": "Store Map & Hours",
	"category": "sm-sections",
	"icon": "location-alt",
	"description": "S.Mart contact page location card: embedded store map, address and opening hours.",
	"keywords": ["contact", "map", "hours", "address", "location"],
	"textdomain": "ai-zippy-child",
	"supports": {
		"html": false,
		"multiple": false,
		"align": false,
		"spacing": { "margin": false, "padding": false },
		"color": { "text": false, "background": false, "link": false }
	},
	"attributes": {
		"mapEmbedUrl": {
			"type": "string",
			"default": "https://www.openstreetmap.org/export/embed.html?bbox=103.835%2C1.276%2C103.865%2C1.296&layer=mapnik&marker=1.2865%2C103.8500"
		},
		"addressLines": {
			"type": "array",
			"default": [
				"S.Mart by Profitrade",
				"10 Example Road, #01-01",
				"Singapore 000000"
			]
		},
		"hoursLines": {
			"type": "array",
			"default": ["Daily", "8:00 AM – 12:00 AM"]
		},
		"pickupNote": {
			"type": "string",
			"default": "Walk-in pickup during opening hours"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
